{
  "name": "marketmimic",
  "version": "1.0.0",
  "description": "MarketMimic - Personal Indian Stock-Market Paper Trading Financial Engine & Mobile App",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
