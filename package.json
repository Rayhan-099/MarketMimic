  "dependencies": {
    "@types/react": "~18.3.12",
    "expo": "~52.0.49",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.22",
    "expo-sqlite": "~15.1.3",
    "expo-status-bar": "~2.0.1",
    "query-string": "^9.5.1",
    "react": "^18.3.1",
    "react-native": "^0.76.7",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
