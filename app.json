{
  "expo": {
    "name": "MarketMimic",
    "slug": "marketmimic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "marketmimic",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#090D16"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.marketmimic.app",
      "adaptiveIcon": {
        "backgroundColor": "#090D16"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
